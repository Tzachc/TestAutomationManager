<Window x:Class="TestAutomationManager.Dialogs.AddTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Test"
        Height="680"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Input Field Style -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                            Opacity="0.5"
                            BlurRadius="20"
                            ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Close Button -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="10,10,0,0"
                    Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Create New Test"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Configure test details and ExtTable settings"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28" Height="28"
                            Margin="0,-4,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕"
                                 FontSize="16"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="20,16">
                <StackPanel>
                    <!-- Test ID Section -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="14"
                           Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="TEST ID" Style="{StaticResource InputLabel}" Margin="0"/>
                                <Button x:Name="FindFreeTestsButton"
                                       HorizontalAlignment="Right"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Cursor="Hand"
                                       Padding="6,4"
                                       Click="FindFreeTestsButton_Click"
                                       ToolTip="Find existing tests marked as FREE (tests that exist but are available for reuse)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="12" Margin="0,0,4,0"/>
                                        <TextBlock Text="Find FREE Tests" FontSize="10"
                                                 Foreground="{DynamicResource PrimaryBlueBrush}"
                                                 TextDecorations="Underline"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ID Mode Toggle -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="AutoIdRadio"
                                           Grid.Column="0"
                                           IsChecked="True"
                                           GroupName="IdMode"
                                           Checked="AutoIdRadio_Checked"
                                           Content="Auto-select ID"
                                           FontSize="12"/>

                                <RadioButton x:Name="ManualIdRadio"
                                           Grid.Column="1"
                                           GroupName="IdMode"
                                           Checked="ManualIdRadio_Checked"
                                           Content="Set ID Manually"
                                           FontSize="12"/>
                            </Grid>

                            <!-- ID Input/Display -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TestIdTextBox"
                                       Grid.Column="0"
                                       Style="{StaticResource InputTextBox}"
                                       IsReadOnly="True"
                                       Text="3"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       TextAlignment="Center"
                                       Padding="8,6"
                                       TextChanged="TestIdTextBox_TextChanged"/>

                                <!-- Suggested ID Info -->
                                <Border x:Name="SuggestedIdInfo"
                                       Grid.Column="1"
                                       Background="{DynamicResource StatusDefaultBackgroundBrush}"
                                       CornerRadius="4"
                                       Padding="8,6"
                                       Margin="8,0,0,0">
                                    <TextBlock FontSize="11"
                                             Foreground="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center">
                                        <Run Text="Next available:"/>
                                        <Run x:Name="SuggestedIdRun" Text="3" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>

                                <!-- Real-time Validation Message -->
                                <Border x:Name="ValidationMessage"
                                       Grid.Column="1"
                                       Background="{DynamicResource StatusErrorBackgroundBrush}"
                                       CornerRadius="4"
                                       Padding="8,6"
                                       Margin="8,0,0,0"
                                       Visibility="Collapsed">
                                    <TextBlock x:Name="ValidationMessageText"
                                             FontSize="11"
                                             Foreground="{DynamicResource ErrorBrush}">
                                        <Run x:Name="ValidationTextRun" Text="Test ID already exists!"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Test Details Section -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="14"
                           Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TEST DETAILS" Style="{StaticResource InputLabel}" Margin="0,0,0,10"/>

                            <!-- Test Name -->
                            <TextBlock Text="Name *" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="TestNameTextBox"
                                   Style="{StaticResource InputTextBox}"
                                   Padding="8,6"
                                   Margin="0,0,0,10"/>

                            <!-- Description -->
                            <TextBlock Text="Description" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="DescriptionTextBox"
                                   Style="{StaticResource InputTextBox}"
                                   Height="50"
                                   TextWrapping="Wrap"
                                   AcceptsReturn="True"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="8,6"
                                   Margin="0,0,0,10"/>

                            <!-- Category -->
                            <TextBlock Text="Category" Style="{StaticResource InputLabel}"/>
                            <ComboBox x:Name="CategoryComboBox"
                                    IsEditable="True"
                                    FontSize="12"
                                    Padding="8,6">
                                <ComboBoxItem>Radzen</ComboBoxItem>
                                <ComboBoxItem>SCMM</ComboBoxItem>
                                <ComboBoxItem>SCMM Funds</ComboBoxItem>
                                <ComboBoxItem>WEB1</ComboBoxItem>
                                <ComboBoxItem>WEB2</ComboBoxItem>
                                <ComboBoxItem>Mobile1</ComboBoxItem>
                                <ComboBoxItem>Mobile2</ComboBoxItem>
                                <ComboBoxItem>Liquidation</ComboBoxItem>
                                <ComboBoxItem>Limits Monitor</ComboBoxItem>
                                <ComboBoxItem>Calculation</ComboBoxItem>
                                <ComboBoxItem>Payments1</ComboBoxItem>
                                <ComboBoxItem>Payments2</ComboBoxItem>
                                <ComboBoxItem>Compliance</ComboBoxItem>
                                <ComboBoxItem>API</ComboBoxItem>
                                <ComboBoxItem>Appium</ComboBoxItem>
                                <ComboBoxItem>IOS</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Process Selection Section -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="14"
                           Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INITIAL PROCESSES (OPTIONAL)" Style="{StaticResource InputLabel}" Margin="0,0,0,6"/>
                            <TextBlock Text="Select existing processes to add to this test"
                                     FontSize="10"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     Margin="0,0,0,10"/>

                            <CheckBox x:Name="Process988CheckBox"
                                    FontSize="11"
                                    Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="ProcessID 988" FontWeight="SemiBold"/>
                                    <Run Text="- Close Active Users Account Number DB"/>
                                </TextBlock>
                            </CheckBox>

                            <CheckBox x:Name="Process271CheckBox"
                                    FontSize="11"
                                    Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="ProcessID 271" FontWeight="SemiBold"/>
                                    <Run Text="- Registration new user and Login to FXNET [WEB]"/>
                                </TextBlock>
                            </CheckBox>

                            <CheckBox x:Name="Process137CheckBox"
                                    FontSize="11">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="ProcessID 137" FontWeight="SemiBold"/>
                                    <Run Text="- Approve users Compliance"/>
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- ExtTable Configuration -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="6"
                           Padding="14">
                        <StackPanel>
                            <TextBlock Text="EXTTABLE CONFIGURATION" Style="{StaticResource InputLabel}" Margin="0,0,0,10"/>

                            <!-- ExtTable Source Toggle -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="TemplateExtRadio"
                                           Grid.Column="0"
                                           IsChecked="True"
                                           GroupName="ExtMode"
                                           Checked="TemplateExtRadio_Checked"
                                           Content="Use Template"
                                           FontSize="12"/>

                                <RadioButton x:Name="CopyExtRadio"
                                           Grid.Column="1"
                                           GroupName="ExtMode"
                                           Checked="CopyExtRadio_Checked"
                                           Content="Copy From Test"
                                           FontSize="12"/>
                            </Grid>

                            <!-- Template Info -->
                            <Border x:Name="TemplateInfo"
                                   Background="{DynamicResource SecondaryBackgroundBrush}"
                                   CornerRadius="4"
                                   Padding="10">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             Margin="0,0,0,2">
                                        <Run Text="Will copy structure from:"/>
                                        <Run Text="ExtTable1" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Default template table"
                                             FontSize="10"
                                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Copy From Test Selector -->
                            <Grid x:Name="CopyFromPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Search Box -->
                                <Border Grid.Row="0" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBox x:Name="ExtTableSearchBox"
                                               Style="{StaticResource InputTextBox}"
                                               Padding="8,6"/>
                                        <TextBlock x:Name="SearchPlaceholder"
                                                 Text="🔍 Search ExtTables..."
                                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                                 FontSize="12"
                                                 Margin="10,8"
                                                 IsHitTestVisible="False"
                                                 Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- ExtTable List -->
                                <Border Grid.Row="1"
                                       Background="{DynamicResource SecondaryBackgroundBrush}"
                                       BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="4"
                                       MaxHeight="120">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ExtTablesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="ExtTableSelection"
                                                               Tag="{Binding TableName}"
                                                               Margin="6,3"
                                                               Checked="ExtTableSelection_Checked"
                                                               FontSize="11">
                                                        <Grid Width="380">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Test ID Badge -->
                                                            <Border Grid.Column="0"
                                                                   Width="22" Height="22"
                                                                   Background="{DynamicResource PrimaryBlueBrush}"
                                                                   CornerRadius="3"
                                                                   Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding TestId}"
                                                                         FontSize="10"
                                                                         FontWeight="Bold"
                                                                         Foreground="White"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Table Name -->
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding TableName}"
                                                                         FontSize="11"
                                                                         FontWeight="SemiBold"
                                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding TestName}"
                                                                         FontSize="9"
                                                                         Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                            </StackPanel>

                                                            <!-- Row Count -->
                                                            <Border Grid.Column="2"
                                                                   Background="{DynamicResource CardBackgroundBrush}"
                                                                   CornerRadius="3"
                                                                   Padding="5,3">
                                                                <TextBlock FontSize="9"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding RowCount}"/>
                                                                    <Run Text="rows"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="0,0,10,10"
                    Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="StatusMessage"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                               Content="Cancel"
                               Style="{StaticResource SecondaryButton}"
                               Width="90"
                               Margin="0,0,8,0"
                               Click="CancelButton_Click"/>

                        <Button x:Name="CreateButton"
                               Content="Create Test"
                               Style="{StaticResource PrimaryButton}"
                               Width="110"
                               Click="CreateButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
