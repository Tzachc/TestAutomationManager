<Window x:Class="TestAutomationManager.Dialogs.StickyNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Note"
        Height="400"
        Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                  Text="📝 Create Quick Note"
                  FontSize="20"
                  FontWeight="Bold"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Margin="0,0,0,20"/>

        <!-- Note Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                      Text="Note Content"
                      Style="{StaticResource LabelStyle}"/>

            <Border Grid.Row="1"
                   Background="{DynamicResource SecondaryBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   CornerRadius="6"
                   Padding="10"
                   Margin="0,0,0,15">
                <TextBox x:Name="ContentTextBox"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        FontSize="13"
                        MaxLength="2000"/>
            </Border>
        </Grid>

        <!-- Color Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Note Color" Style="{StaticResource LabelStyle}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ColorButton1" Width="50" Height="50" Margin="0,0,8,0"
                       Background="#FFE57F" Click="ColorButton_Click" Tag="#FFE57F"
                       BorderThickness="3" BorderBrush="Transparent"
                       CornerRadius="8"/>
                <Button x:Name="ColorButton2" Width="50" Height="50" Margin="0,0,8,0"
                       Background="#A7FFEB" Click="ColorButton_Click" Tag="#A7FFEB"
                       BorderThickness="3" BorderBrush="Transparent"
                       CornerRadius="8"/>
                <Button x:Name="ColorButton3" Width="50" Height="50" Margin="0,0,8,0"
                       Background="#B3E5FC" Click="ColorButton_Click" Tag="#B3E5FC"
                       BorderThickness="3" BorderBrush="Transparent"
                       CornerRadius="8"/>
                <Button x:Name="ColorButton4" Width="50" Height="50" Margin="0,0,8,0"
                       Background="#F8BBD0" Click="ColorButton_Click" Tag="#F8BBD0"
                       BorderThickness="3" BorderBrush="Transparent"
                       CornerRadius="8"/>
                <Button x:Name="ColorButton5" Width="50" Height="50" Margin="0,0,8,0"
                       Background="#E1BEE7" Click="ColorButton_Click" Tag="#E1BEE7"
                       BorderThickness="3" BorderBrush="Transparent"
                       CornerRadius="8"/>
            </StackPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                   Width="100"
                   Height="40"
                   Margin="0,0,10,0"
                   Background="{DynamicResource SecondaryBackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   BorderThickness="0"
                   Cursor="Hand"
                   Click="Cancel_Click"
                   IsCancel="True"/>

            <Button Content="Create Note"
                   Width="120"
                   Height="40"
                   Background="{DynamicResource PrimaryBlueBrush}"
                   Foreground="White"
                   FontSize="13"
                   FontWeight="SemiBold"
                   BorderThickness="0"
                   Cursor="Hand"
                   Click="Create_Click"
                   IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
