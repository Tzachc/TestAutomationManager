<Window x:Class="TestAutomationManager.Dialogs.EditConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirm Changes"
        SizeToContent="Height"
        MinWidth="700"
        MaxWidth="1000"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Change row style -->
        <Style x:Key="ChangeRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚠️ Confirm Your Changes"
                      FontSize="20"
                      FontWeight="Bold"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,0,8"/>
            <TextBlock Text="Review the changes below before saving to the database."
                      FontSize="13"
                      Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Changes List -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChangesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ChangeRow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Field Name -->
                                    <TextBlock Grid.Row="0"
                                              Text="{Binding FieldName}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="0,0,0,6"/>

                                    <!-- Change Display: Side-by-Side Comparison -->
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- OLD VALUE -->
                                        <Border Grid.Column="0"
                                               Background="#FFF5F5"
                                               BorderBrush="#E74C3C"
                                               BorderThickness="2"
                                               CornerRadius="8"
                                               Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="BEFORE"
                                                          FontSize="10"
                                                          FontWeight="Bold"
                                                          Foreground="#E74C3C"
                                                          Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding OldValue}"
                                                          FontSize="14"
                                                          FontFamily="Consolas"
                                                          TextWrapping="Wrap"
                                                          Foreground="#333333">
                                                    <TextBlock.TextDecorations>
                                                        <TextDecoration Location="Strikethrough">
                                                            <TextDecoration.Pen>
                                                                <Pen Brush="#E74C3C" Thickness="1.5"/>
                                                            </TextDecoration.Pen>
                                                        </TextDecoration>
                                                    </TextBlock.TextDecorations>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- ARROW -->
                                        <TextBlock Grid.Column="1"
                                                  Text="→"
                                                  FontSize="32"
                                                  FontWeight="Bold"
                                                  Foreground="#3498DB"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0"/>

                                        <!-- NEW VALUE -->
                                        <Border Grid.Column="2"
                                               Background="#E8F8F5"
                                               BorderBrush="#27AE60"
                                               BorderThickness="3"
                                               CornerRadius="8"
                                               Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="AFTER"
                                                          FontSize="10"
                                                          FontWeight="Bold"
                                                          Foreground="#27AE60"
                                                          Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding NewValue}"
                                                          FontSize="15"
                                                          FontWeight="Bold"
                                                          FontFamily="Consolas"
                                                          Foreground="#27AE60"
                                                          TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Empty row to maintain spacing -->
                                    <Grid Grid.Row="2"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                   Content="✗ Cancel"
                   Width="120"
                   Height="36"
                   Margin="0,0,12,0"
                   Click="CancelButton_Click"
                   Background="{DynamicResource SecondaryBackgroundBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button x:Name="SaveButton"
                   Content="✓ Save Changes"
                   Width="140"
                   Height="36"
                   Click="SaveButton_Click"
                   Background="{DynamicResource SuccessBrush}"
                   Foreground="White"
                   FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
