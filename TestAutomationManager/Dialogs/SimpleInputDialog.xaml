<Window x:Class="TestAutomationManager.Dialogs.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Prompt}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" x:Name="InputTextBox"
                 Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Top"
                 Padding="8"
                 FontSize="13"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource PrimaryBlueBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Width="80" Height="32" Margin="0,0,10,0"
                    Click="OkButton_Click" IsDefault="True"
                    Background="{DynamicResource PrimaryBlueBrush}"
                    Foreground="White"/>
            <Button Content="Cancel" Width="80" Height="32"
                    Click="CancelButton_Click" IsCancel="True"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
