<Window x:Class="TestAutomationManager.Dialogs.TodoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ResizeMode="CanResize"
        MinHeight="600"
        MinWidth="550">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                      x:Name="DialogTitle"
                      Text="Create New Task"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,0,25"/>

            <!-- Form Fields -->
            <StackPanel Grid.Row="1">
                <!-- Title -->
                <TextBlock Text="Task Title *" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TitleTextBox"
                        Style="{StaticResource InputStyle}"
                        MaxLength="200"/>

                <!-- Description -->
                <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox"
                        Style="{StaticResource InputStyle}"
                        Height="80"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        MaxLength="2000"/>

                <!-- Due Date and Priority Row -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Due Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="DueDatePicker"
                                   Style="{StaticResource DatePickerStyle}"
                                   Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Priority" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="PriorityComboBox"
                                 Style="{StaticResource ComboStyle}"
                                 SelectedIndex="1"
                                 Margin="0">
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Low"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Category and Status Row -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Category" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="CategoryComboBox"
                                 Style="{StaticResource ComboStyle}"
                                 Margin="0"
                                 IsEditable="True">
                            <ComboBoxItem Content="Work"/>
                            <ComboBoxItem Content="Personal"/>
                            <ComboBoxItem Content="Project"/>
                            <ComboBoxItem Content="Bug"/>
                            <ComboBoxItem Content="Feature"/>
                            <ComboBoxItem Content="Research"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="StatusComboBox"
                                 Style="{StaticResource ComboStyle}"
                                 SelectedIndex="0"
                                 Margin="0">
                            <ComboBoxItem Content="Todo"/>
                            <ComboBoxItem Content="InProgress"/>
                            <ComboBoxItem Content="Done"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Tags -->
                <TextBlock Text="Tags (comma-separated)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TagsTextBox"
                        Style="{StaticResource InputStyle}"
                        MaxLength="500"/>

                <!-- Time Tracking Row -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estimated Time (minutes)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EstimatedMinutesTextBox"
                                Style="{StaticResource InputStyle}"
                                Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Actual Time (minutes)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ActualMinutesTextBox"
                                Style="{StaticResource InputStyle}"
                                Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- Color Picker -->
                <TextBlock Text="Card Color (optional)" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="ColorButton1" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#539BF5" Click="ColorButton_Click" Tag="#539BF5"
                           BorderThickness="2" BorderBrush="Transparent"/>
                    <Button x:Name="ColorButton2" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#66BB6A" Click="ColorButton_Click" Tag="#66BB6A"
                           BorderThickness="2" BorderBrush="Transparent"/>
                    <Button x:Name="ColorButton3" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#FFA726" Click="ColorButton_Click" Tag="#FFA726"
                           BorderThickness="2" BorderBrush="Transparent"/>
                    <Button x:Name="ColorButton4" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#EF5350" Click="ColorButton_Click" Tag="#EF5350"
                           BorderThickness="2" BorderBrush="Transparent"/>
                    <Button x:Name="ColorButton5" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#AB47BC" Click="ColorButton_Click" Tag="#AB47BC"
                           BorderThickness="2" BorderBrush="Transparent"/>
                    <Button x:Name="ColorButton6" Width="40" Height="40" Margin="0,0,10,0"
                           Background="#9E9E9E" Click="ColorButton_Click" Tag="#9E9E9E"
                           BorderThickness="2" BorderBrush="Transparent"/>
                </StackPanel>

                <!-- Attachment URL -->
                <TextBlock Text="Attachment URL (optional)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="AttachmentUrlTextBox"
                        Style="{StaticResource InputStyle}"
                        MaxLength="500"/>

                <!-- Recurring Task -->
                <CheckBox x:Name="IsRecurringCheckBox"
                         Content="Recurring Task"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="13"
                         Margin="0,0,0,10"
                         Checked="IsRecurring_CheckedChanged"
                         Unchecked="IsRecurring_CheckedChanged"/>

                <StackPanel x:Name="RecurrencePanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Recurrence Pattern" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="RecurrenceComboBox"
                             Style="{StaticResource ComboStyle}"
                             SelectedIndex="0"
                             Margin="0">
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="Monthly"/>
                        <ComboBoxItem Content="Yearly"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       x:Name="DeleteButton"
                       Content="Delete Task"
                       Width="120"
                       Height="40"
                       HorizontalAlignment="Left"
                       Background="#EF5350"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       BorderThickness="0"
                       Cursor="Hand"
                       Visibility="Collapsed"
                       Click="Delete_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                           Width="100"
                           Height="40"
                           Margin="0,0,10,0"
                           Background="{DynamicResource SecondaryBackgroundBrush}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="Cancel_Click"
                           IsCancel="True"/>

                    <Button Content="Save Task"
                           Width="100"
                           Height="40"
                           Background="{DynamicResource PrimaryBlueBrush}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="Save_Click"
                           IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
