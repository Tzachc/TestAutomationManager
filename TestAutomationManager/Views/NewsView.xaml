<UserControl x:Class="TestAutomationManager.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TestAutomationManager.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource PrimaryBackgroundBrush}">

    <UserControl.Resources>
        <!-- This must match the namespace in your project -->
        <converters:ImageUrlConverter x:Key="ImageUrlConverter"/>

        <!-- Category Color Brushes -->
        <SolidColorBrush x:Key="AutomationCategoryBrush" Color="#FF6366F1"/>
        <SolidColorBrush x:Key="AICategoryBrush" Color="#FF10B981"/>
        <SolidColorBrush x:Key="DevOpsCategoryBrush" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="SetupCategoryBrush" Color="#FFEC4899"/>

        <!-- Easing Function for smooth animations -->
        <CubicEase x:Key="SmoothEase" EasingMode="EaseOut"/>

        <!-- 
        ============================================================
        Modern Card Style
        - Only handles background, shadow, and corner radius.
        - Animations are moved INTO the DataTemplates for more control.
        ============================================================
        -->
        <Style x:Key="ModernNewsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="15" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Badge Style (Unchanged) -->
        <Style x:Key="CategoryPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style (Unchanged) -->
        <Style x:Key="FilterPillStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 
        ============================================================
        NEW: Entrance Animation Style
        - Makes the item fade-in and slide-up on load.
        ============================================================
        -->
        <Style x:Key="EntranceAnimationStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="20"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.5"
                                             DecelerationRatio="0.8" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.5"
                                             EasingFunction="{StaticResource SmoothEase}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 
        ============================================================
        Featured News Card Template - FIXED
        - REMOVED DataType="{x:Type models:NewsArticle}" to prevent compile errors.
        - Added x:Name attributes for animations.
        ============================================================
        -->
        <DataTemplate x:Key="FeaturedNewsCardTemplate">
            <Border Style="{StaticResource ModernNewsCardStyle}"
                    MouseLeftButtonDown="NewsCard_Click"
                    Tag="{Binding Url}"
                    Margin="40,16,40,16"
                    x:Name="FeaturedCardRoot">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Article Image Area -->
                    <Border Grid.Column="0"
                            CornerRadius="20,0,0,20"
                            ClipToBounds="True"
                            Background="#FF1E293B"
                            MinHeight="400"
                            x:Name="ImageContainer">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                        </Border.RenderTransform>

                        <Grid>
                            <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                   Stretch="UniformToFill"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                            <!-- Fallback for no image -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="📰"
                                           FontSize="120"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.2"/>
                            </Grid>

                            <!-- Dark Gradient Overlay -->
                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#55000000" Offset="0.7"/>
                                        <GradientStop Color="#CC000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Category Badge on Image -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,20">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CategoryPillStyle}">
                                        <Setter Property="Background" Value="#FF6366F1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="Test Automation">
                                                <Setter Property="Background" Value="{StaticResource AutomationCategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="AI &amp; ML">
                                                <Setter Property="Background" Value="{StaticResource AICategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="DevOps">
                                                <Setter Property="Background" Value="{StaticResource DevOpsCategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="Setup">
                                                <Setter Property="Background" Value="{StaticResource SetupCategoryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Source Badge at Bottom -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,20,20">
                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PrimaryBlueBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="📰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding TimeAgo}" FontSize="12" Foreground="White" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Border Grid.Column="1" Padding="32,32,32,32">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" LineHeight="36" MaxHeight="180"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,20"/>

                            <!-- Description -->
                            <TextBlock Text="{Binding Description}"
                                       FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="26" MaxHeight="130"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,30"/>

                            <!-- Read More Button -->
                            <Border Background="{DynamicResource PrimaryBlueBrush}"
                                    CornerRadius="12" Padding="20,12"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Read Full Story"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="→"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="White" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               x:Name="ArrowText">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hover Animations for Featured Card -->
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True" SourceName="FeaturedCardRoot">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Image Zoom In -->
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.1" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.1" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <!-- Arrow Slide Right -->
                                <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="5" Duration="0:0:0.3" EasingFunction="{StaticResource SmoothEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Image Zoom Out -->
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <!-- Arrow Slide Back -->
                                <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.3" EasingFunction="{StaticResource SmoothEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>

        </DataTemplate>

        <!-- 
        ============================================================
        Regular News Card Template - FIXED
        - REMOVED DataType="{x:Type models:NewsArticle}" to prevent compile errors.
        - Added x:Name attributes for animations.
        ============================================================
        -->
        <DataTemplate x:Key="RegularNewsCardTemplate">
            <Border Style="{StaticResource ModernNewsCardStyle}"
                    MouseLeftButtonDown="NewsCard_Click"
                    Tag="{Binding Url}"
                    x:Name="RegularCardRoot">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Article Image -->
                    <Border Grid.Row="0"
                            CornerRadius="20,20,0,0"
                            ClipToBounds="True"
                            Background="#FF1E293B"
                            x:Name="ImageContainer">

                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                        </Border.RenderTransform>

                        <Grid>
                            <Image Source="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                                   Stretch="UniformToFill"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                            <!-- Fallback for no image -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="📰"
                                           FontSize="80"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.2"/>
                            </Grid>

                            <!-- Dark Gradient Overlay -->
                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#55000000" Offset="0.7"/>
                                        <GradientStop Color="#CC000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Category Badge on Image -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,20">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CategoryPillStyle}">
                                        <Setter Property="Background" Value="#FF6366F1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Category}" Value="Test Automation">
                                                <Setter Property="Background" Value="{StaticResource AutomationCategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="AI &amp; ML">
                                                <Setter Property="Background" Value="{StaticResource AICategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="DevOps">
                                                <Setter Property="Background" Value="{StaticResource DevOpsCategoryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Category}" Value="Setup">
                                                <Setter Property="Background" Value="{StaticResource SetupCategoryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Source Badge at Bottom -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,20,20">
                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PrimaryBlueBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="📰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="White" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Border Grid.Row="1" Padding="20,20,20,24">
                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" LineHeight="26" MaxHeight="78"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                            <!-- Description -->
                            <TextBlock Text="{Binding Description}"
                                       FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="22" MaxHeight="66"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>

                            <!-- Read More (Subtle) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Cursor="Hand">
                                <TextBlock Text="Read Story"
                                             Foreground="{DynamicResource PrimaryBlueBrush}"
                                             FontWeight="SemiBold"
                                             FontSize="14"/>
                                <TextBlock Text="→"
                                           Foreground="{DynamicResource PrimaryBlueBrush}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Margin="6,0,0,0"
                                           x:Name="ArrowText">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hover Animations for Regular Card -->
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True" SourceName="RegularCardRoot">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Image Zoom In -->
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.15" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.15" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <!-- Arrow Slide Right -->
                                <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="5" Duration="0:0:0.3" EasingFunction="{StaticResource SmoothEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Image Zoom Out -->
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <DoubleAnimation Storyboard.TargetName="ImageContainer"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEase}"/>
                                <!-- Arrow Slide Back -->
                                <DoubleAnimation Storyboard.TargetName="ArrowText"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.3" EasingFunction="{StaticResource SmoothEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>

        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 
        ============================================================
        HEADER - REDESIGNED
        - Filters are moved to a separate row for a "tab" feel
        ============================================================
        -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Row 1: Title and Refresh -->
                <!-- FIXED: Changed Padding to Margin on the Grid -->
                <Grid Margin="40,20,40,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📰"
                                   FontSize="28"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tech News"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryBlueBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Row 2: Filters -->
                <StackPanel Orientation="Horizontal" Margin="40,0,40,20">
                    <ToggleButton x:Name="FilterAll"
                                  Content="All"
                                  Style="{StaticResource FilterPillStyle}"
                                  IsChecked="True"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterAutomation"
                                  Content="🧪 Testing"
                                  Style="{StaticResource FilterPillStyle}"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterAI"
                                  Content="🤖 AI"
                                  Style="{StaticResource FilterPillStyle}"
                                  Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterDevOps"
                                  Content="⚙️ DevOps"
                                  Style="{StaticResource FilterPillStyle}"
                                  Click="FilterButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 
        ============================================================
        Main Content Area
        ============================================================
        -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource PrimaryBackgroundBrush}">

            <!-- Overall StackPanel for all content states -->
            <StackPanel>
                <!-- Loading State -->
                <Grid x:Name="LoadingPanel"
                      Visibility="Visible"
                      MinHeight="400">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Loading the latest tech news..."
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Grid x:Name="EmptyPanel"
                      Visibility="Collapsed"
                      MinHeight="400">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="📭" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="No news articles found"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Try selecting a different category"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Main Content Panel (holds featured + grid) -->
                <StackPanel x:Name="ContentRootPanel" Visibility="Collapsed">

                    <!-- Featured Section -->
                    <TextBlock Text="🌟 Featured Story"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="40,32,40,0"/>

                    <!-- Entrance Animation Applied -->
                    <ContentControl x:Name="FeaturedNewsControl"
                                    ContentTemplate="{StaticResource FeaturedNewsCardTemplate}"
                                    Style="{StaticResource EntranceAnimationStyle}"/>

                    <!-- Headlines Section -->
                    <TextBlock Text="More Headlines"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="40,24,40,0"/>

                    <!-- News Grid -->
                    <ItemsControl x:Name="RegularNewsItemsControl"
                                  Padding="24,0,24,40">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- Use the regular card template -->
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="RegularNewsCardTemplate"/>
                        </ItemsControl.ItemTemplate>

                        <!-- Entrance Animation Applied to each item -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="20"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Added BeginTime for a staggered effect -->
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0:0:0.5"
                                                                 BeginTime="0:0:0.1"
                                                                 DecelerationRatio="0.8" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0"
                                                                 Duration="0:0:0.5"
                                                                 BeginTime="0:0:0.1"
                                                                 EasingFunction="{StaticResource SmoothEase}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>