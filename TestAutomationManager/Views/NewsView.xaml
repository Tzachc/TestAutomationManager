<UserControl x:Class="TestAutomationManager.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource PrimaryBackgroundBrush}">

    <UserControl.Resources>
        <!-- Category Color Brushes -->
        <SolidColorBrush x:Key="AutomationCategoryBrush" Color="#FF6366F1"/>
        <SolidColorBrush x:Key="AICategoryBrush" Color="#FF10B981"/>
        <SolidColorBrush x:Key="DevOpsCategoryBrush" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="SetupCategoryBrush" Color="#FFEC4899"/>

        <!-- Modern Card Style -->
        <Style x:Key="ModernNewsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="20" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.25"
                                               To="1.03"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               DecelerationRatio="0.7"/>
                                <DoubleAnimation Duration="0:0:0.25"
                                               To="1.03"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               DecelerationRatio="0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.25"
                                               To="1"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                               DecelerationRatio="0.7"/>
                                <DoubleAnimation Duration="0:0:0.25"
                                               To="1"
                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                               DecelerationRatio="0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="40" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Badge Style -->
        <Style x:Key="CategoryPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="FilterPillStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and Filters Combined -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📰"
                               FontSize="28"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Tech News"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,30,0"
                               VerticalAlignment="Center"/>

                    <ToggleButton x:Name="FilterAll"
                                Content="All"
                                Style="{StaticResource FilterPillStyle}"
                                IsChecked="True"
                                Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterAutomation"
                                Content="🧪 Testing"
                                Style="{StaticResource FilterPillStyle}"
                                Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterAI"
                                Content="🤖 AI"
                                Style="{StaticResource FilterPillStyle}"
                                Click="FilterButton_Click"/>
                    <ToggleButton x:Name="FilterDevOps"
                                Content="⚙️ DevOps"
                                Style="{StaticResource FilterPillStyle}"
                                Click="FilterButton_Click"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryBlueBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="20,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource PrimaryBackgroundBrush}">
            <StackPanel>
                <!-- Loading State -->
                <Grid x:Name="LoadingPanel"
                      Visibility="Visible"
                      MinHeight="400">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Loading the latest tech news..."
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State -->
                <Grid x:Name="EmptyPanel"
                      Visibility="Collapsed"
                      MinHeight="400">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="📭" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="No news articles found"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Try selecting a different category"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- News Grid -->
                <ItemsControl x:Name="NewsItemsControl"
                              Visibility="Collapsed"
                              Padding="24,20,24,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernNewsCardStyle}"
                                    MouseLeftButtonDown="NewsCard_Click"
                                    Tag="{Binding Url}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="300"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- MASSIVE Article Image -->
                                    <Border Grid.Row="0"
                                            CornerRadius="20,20,0,0"
                                            ClipToBounds="True"
                                            Background="#FF1E293B">
                                        <Grid>
                                            <!-- Image -->
                                            <Image Source="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                            <!-- Fallback for no image -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBlock Text="📰"
                                                           FontSize="120"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.2"/>
                                            </Grid>

                                            <!-- Dark Gradient Overlay -->
                                            <Border VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="#55000000" Offset="0.7"/>
                                                        <GradientStop Color="#CC000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- Category Badge on Image -->
                                            <Border VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Margin="20,20">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource CategoryPillStyle}">
                                                        <Setter Property="Background" Value="#FF6366F1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="Test Automation">
                                                                <Setter Property="Background" Value="{StaticResource AutomationCategoryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="AI &amp; ML">
                                                                <Setter Property="Background" Value="{StaticResource AICategoryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="DevOps">
                                                                <Setter Property="Background" Value="{StaticResource DevOpsCategoryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="Setup">
                                                                <Setter Property="Background" Value="{StaticResource SetupCategoryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Source Badge at Bottom -->
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Bottom"
                                                        Margin="20,0,20,20">
                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource PrimaryBlueBrush}"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="📰"
                                                               FontSize="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                    <TextBlock Text="{Binding TimeAgo}"
                                                               FontSize="12"
                                                               Foreground="White"
                                                               Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Content Area -->
                                    <Border Grid.Row="1"
                                            Padding="26,24,26,26">
                                        <StackPanel>
                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="30"
                                                   MaxHeight="90"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,14"/>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"
                                                   MaxHeight="72"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,20"/>

                                        <!-- Read More Button -->
                                        <Border Background="{DynamicResource PrimaryBlueBrush}"
                                                CornerRadius="12"
                                                Padding="20,12"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Read Full Story"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="→"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
