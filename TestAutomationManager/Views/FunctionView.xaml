<UserControl x:Class="TestAutomationManager.Views.FunctionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TestAutomationManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1600"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             Loaded="FunctionView_Loaded"
             Unloaded="FunctionView_Unloaded">

    <UserControl.Resources>
        <!-- Modern ScrollBar -->
        <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="4" Margin="4">
                                <Track x:Name="PART_Track"
                                       Orientation="{TemplateBinding Orientation}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="MinWidth" Value="14"/>
                                                    <Setter Property="MinHeight" Value="14"/>
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                                <Setter Property="Width" Value="14"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter Property="Height" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Container -->
    <Grid>
        <!-- Main Layout -->
        <Grid Grid.IsSharedSizeScope="True" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Sticky Main Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <ScrollViewer x:Name="HeaderScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <Border Padding="28,8">
                    <Grid MinWidth="10000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"  SharedSizeGroup="cWEB3Operator"/>
                            <ColumnDefinition Width="250" SharedSizeGroup="cComments"/>
                            <ColumnDefinition Width="100"  SharedSizeGroup="cProcessID"/>
                            <ColumnDefinition Width="120" SharedSizeGroup="cFunctionPosition"/>
                            <ColumnDefinition Width="350" SharedSizeGroup="cFunctionDescription"/>
                            <ColumnDefinition Width="400" SharedSizeGroup="cFunctionName"/>
                            <ColumnDefinition Width="140" SharedSizeGroup="cPassFailOp"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam01"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam02"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam03"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam04"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam05"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam06"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam07"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam08"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam09"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam10"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam11"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam12"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam13"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam14"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam15"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam16"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam17"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam18"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam19"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam20"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam21"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam22"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam23"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam24"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam25"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam26"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam27"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam28"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam29"/>
                            <ColumnDefinition Width="200" SharedSizeGroup="funcParam30"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"  Text="WEB3 OPERATOR" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="1"  Text="COMMENTS" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="2"  Text="PROCESS ID" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="3"  Text="POSITION" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="4"  Text="DESCRIPTION" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="5"  Text="FUNCTION NAME" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="6"  Text="PASS/FAIL" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Grid.Column="7"  Text="PARAM 1"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="8"  Text="PARAM 2"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="PARAM 3"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="PARAM 4"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="11" Text="PARAM 5"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="12" Text="PARAM 6"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="13" Text="PARAM 7"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="14" Text="PARAM 8"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="15" Text="PARAM 9"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="16" Text="PARAM 10" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="17" Text="PARAM 11" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="18" Text="PARAM 12" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="19" Text="PARAM 13" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="20" Text="PARAM 14" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="21" Text="PARAM 15" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="22" Text="PARAM 16" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="23" Text="PARAM 17" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="24" Text="PARAM 18" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="25" Text="PARAM 19" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="26" Text="PARAM 20" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="27" Text="PARAM 21" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="28" Text="PARAM 22" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="29" Text="PARAM 23" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="30" Text="PARAM 24" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="31" Text="PARAM 25" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="32" Text="PARAM 26" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="33" Text="PARAM 27" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="34" Text="PARAM 28" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="35" Text="PARAM 29" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="36" Text="PARAM 30" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- Scrollable Body with VIRTUALIZATION for large datasets -->
        <ListBox Grid.Row="1"
                 x:Name="FunctionsItemsControl"
                 Margin="10,5,24,24"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.CacheLength="20,20"
                 VirtualizingPanel.CacheLengthUnit="Item"
                 PreviewMouseDown="MainScrollViewer_PreviewMouseDown"
                 PreviewMouseMove="MainScrollViewer_PreviewMouseMove"
                 PreviewMouseUp="MainScrollViewer_PreviewMouseUp"
                 MouseLeave="MainScrollViewer_MouseLeave">

            <!-- Remove default ListBox selection visual -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                Padding="24,10">
                            <Grid MinWidth="10000">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cWEB3Operator"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cComments"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cProcessID"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cFunctionPosition"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cFunctionDescription"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cFunctionName"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="cPassFailOp"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam01"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam02"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam03"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam04"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam05"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam06"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam07"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam08"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam09"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam10"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam11"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam12"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam13"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam14"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam15"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam16"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam17"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam18"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam19"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam20"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam21"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam22"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam23"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam24"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam25"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam26"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam27"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam28"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam29"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="funcParam30"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding WEB3Operator}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding WEB3Operator}"/>

                                <TextBlock Grid.Column="1" Text="{Binding Comments}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Comments}"/>

                                <TextBlock Grid.Column="2" Text="{Binding ProcessID}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="{Binding FunctionPosition}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>

                                <TextBlock Grid.Column="4" Text="{Binding FunctionDescription}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FunctionDescription}"/>

                                <TextBlock Grid.Column="5" Text="{Binding FunctionName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FunctionName}"/>

                                <TextBlock Grid.Column="6" Text="{Binding Pass_Fail_WEB3Operator}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Pass_Fail_WEB3Operator}"/>

                                <TextBlock Grid.Column="7" Text="{Binding Param1}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param1}"/>
                                <TextBlock Grid.Column="8" Text="{Binding Param2}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param2}"/>
                                <TextBlock Grid.Column="9" Text="{Binding Param3}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param3}"/>
                                <TextBlock Grid.Column="10" Text="{Binding Param4}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param4}"/>
                                <TextBlock Grid.Column="11" Text="{Binding Param5}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param5}"/>
                                <TextBlock Grid.Column="12" Text="{Binding Param6}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param6}"/>
                                <TextBlock Grid.Column="13" Text="{Binding Param7}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param7}"/>
                                <TextBlock Grid.Column="14" Text="{Binding Param8}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param8}"/>
                                <TextBlock Grid.Column="15" Text="{Binding Param9}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param9}"/>
                                <TextBlock Grid.Column="16" Text="{Binding Param10}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param10}"/>
                                <TextBlock Grid.Column="17" Text="{Binding Param11}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param11}"/>
                                <TextBlock Grid.Column="18" Text="{Binding Param12}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param12}"/>
                                <TextBlock Grid.Column="19" Text="{Binding Param13}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param13}"/>
                                <TextBlock Grid.Column="20" Text="{Binding Param14}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param14}"/>
                                <TextBlock Grid.Column="21" Text="{Binding Param15}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param15}"/>
                                <TextBlock Grid.Column="22" Text="{Binding Param16}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param16}"/>
                                <TextBlock Grid.Column="23" Text="{Binding Param17}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param17}"/>
                                <TextBlock Grid.Column="24" Text="{Binding Param18}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param18}"/>
                                <TextBlock Grid.Column="25" Text="{Binding Param19}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param19}"/>
                                <TextBlock Grid.Column="26" Text="{Binding Param20}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param20}"/>
                                <TextBlock Grid.Column="27" Text="{Binding Param21}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param21}"/>
                                <TextBlock Grid.Column="28" Text="{Binding Param22}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param22}"/>
                                <TextBlock Grid.Column="29" Text="{Binding Param23}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param23}"/>
                                <TextBlock Grid.Column="30" Text="{Binding Param24}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param24}"/>
                                <TextBlock Grid.Column="31" Text="{Binding Param25}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param25}"/>
                                <TextBlock Grid.Column="32" Text="{Binding Param26}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param26}"/>
                                <TextBlock Grid.Column="33" Text="{Binding Param27}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param27}"/>
                                <TextBlock Grid.Column="34" Text="{Binding Param28}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param28}"/>
                                <TextBlock Grid.Column="35" Text="{Binding Param29}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param29}"/>
                                <TextBlock Grid.Column="36" Text="{Binding Param30}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Param30}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              Visibility="Collapsed"
              Background="#CC000000"
              Panel.ZIndex="1000">
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="40,30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="400">
            <StackPanel>
                <TextBlock Text="Loading Functions..."
                           x:Name="LoadingProgressText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <ProgressBar x:Name="LoadingProgressBar"
                             Height="8"
                             MinWidth="350"
                             Background="{DynamicResource SecondaryBackgroundBrush}"
                             Foreground="#4CAF50"
                             BorderThickness="0"
                             Margin="0,0,0,15"/>

                <TextBlock x:Name="LoadingPercentageText"
                           Text="0%"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>

        <!-- Record Count Footer (Overlay - doesn't reduce page size) -->
        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="100"
                Padding="16,8">
            <TextBlock x:Name="RecordCountText"
                       Text="0 functions"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Right"/>
        </Border>
    </Grid>

</UserControl>
