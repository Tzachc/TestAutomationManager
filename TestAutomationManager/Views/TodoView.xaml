<UserControl x:Class="TestAutomationManager.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- ============================================================
        MODERN CARD STYLES FOR TODO ITEMS
        ============================================================ -->

        <Style x:Key="TodoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="20" ShadowDepth="4"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StickyNoteStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="25" ShadowDepth="5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PriorityBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="CategoryBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="KanbanColumnStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="ViewToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBlueBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
        TOOLBAR
        ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="✚ New Task"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="NewTask_Click"/>

                    <Button Content="📝 Quick Note"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="NewStickyNote_Click"/>

                    <ComboBox x:Name="FilterComboBox"
                              Width="150"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Tasks" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Completed"/>
                        <ComboBoxItem Content="High Priority"/>
                        <ComboBoxItem Content="Overdue"/>
                    </ComboBox>

                    <TextBox x:Name="SearchTextBox"
                             Width="200"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Padding="8"
                             Text=""
                             TextChanged="Search_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- View Toggle Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton Content="📋 Kanban Board"
                                  x:Name="KanbanViewToggle"
                                  Style="{StaticResource ViewToggleButtonStyle}"
                                  IsChecked="True"
                                  Margin="0,0,8,0"
                                  Checked="ViewToggle_Changed"/>

                    <ToggleButton Content="📌 Sticky Notes"
                                  x:Name="StickyNotesViewToggle"
                                  Style="{StaticResource ViewToggleButtonStyle}"
                                  Checked="ViewToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
        MAIN CONTENT AREA
        ============================================================ -->
        <Grid Grid.Row="1">
            <!-- Kanban Board View -->
            <ScrollViewer x:Name="KanbanScrollViewer"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Visibility="Visible">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TODO COLUMN -->
                    <Border Grid.Column="0" Style="{StaticResource KanbanColumnStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📝 To Do"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                                <Border Background="#539BF5"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       Margin="10,0,0,0">
                                    <TextBlock x:Name="TodoCountText"
                                              Text="0"
                                              FontSize="12"
                                              FontWeight="Bold"
                                              Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Todo Items -->
                            <ListBox x:Name="TodoListBox"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AllowDrop="True"
                                    Drop="TodoColumn_Drop"
                                    DragEnter="Column_DragEnter"
                                    DragLeave="Column_DragLeave">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TodoCardStyle}"
                                               MouseLeftButtonDown="TodoCard_MouseDown"
                                               MouseMove="TodoCard_MouseMove"
                                               MouseLeftButtonUp="TodoCard_MouseUp"
                                               Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="0"
                                                          Text="{Binding Title}"
                                                          FontSize="15"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,0,0,8"/>

                                                <!-- Description -->
                                                <TextBlock Grid.Row="1"
                                                          Text="{Binding Description}"
                                                          FontSize="12"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,0,0,10"
                                                          MaxHeight="40"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <!-- Badges Row -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Style="{StaticResource PriorityBadgeStyle}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding PriorityColor}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Priority}"
                                                                  FontSize="10"
                                                                  FontWeight="Bold"
                                                                  Foreground="White"/>
                                                    </Border>

                                                    <Border Style="{StaticResource CategoryBadgeStyle}"
                                                           Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Category}"
                                                                  FontSize="10"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Footer: Due Date & Time -->
                                                <Grid Grid.Row="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding DueDateDisplay}"
                                                              FontSize="11"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="⏱️"
                                                                  FontSize="11"
                                                                  Margin="0,0,4,0"
                                                                  Visibility="{Binding EstimatedTimeDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding EstimatedTimeDisplay}"
                                                                  FontSize="11"
                                                                  Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- IN PROGRESS COLUMN -->
                    <Border Grid.Column="1" Style="{StaticResource KanbanColumnStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⚡ In Progress"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                                <Border Background="#FFA726"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       Margin="10,0,0,0">
                                    <TextBlock x:Name="InProgressCountText"
                                              Text="0"
                                              FontSize="12"
                                              FontWeight="Bold"
                                              Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- In Progress Items -->
                            <ListBox x:Name="InProgressListBox"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AllowDrop="True"
                                    Drop="InProgressColumn_Drop"
                                    DragEnter="Column_DragEnter"
                                    DragLeave="Column_DragLeave">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TodoCardStyle}"
                                               MouseLeftButtonDown="TodoCard_MouseDown"
                                               MouseMove="TodoCard_MouseMove"
                                               MouseLeftButtonUp="TodoCard_MouseUp"
                                               Tag="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                          Text="{Binding Title}"
                                                          FontSize="15"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="1"
                                                          Text="{Binding Description}"
                                                          FontSize="12"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,0,0,10"
                                                          MaxHeight="40"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Style="{StaticResource PriorityBadgeStyle}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding PriorityColor}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Priority}"
                                                                  FontSize="10"
                                                                  FontWeight="Bold"
                                                                  Foreground="White"/>
                                                    </Border>

                                                    <Border Style="{StaticResource CategoryBadgeStyle}"
                                                           Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Category}"
                                                                  FontSize="10"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <Grid Grid.Row="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding DueDateDisplay}"
                                                              FontSize="11"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="⏱️"
                                                                  FontSize="11"
                                                                  Margin="0,0,4,0"
                                                                  Visibility="{Binding ActualTimeDisplay, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding ActualTimeDisplay}"
                                                                  FontSize="11"
                                                                  Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- DONE COLUMN -->
                    <Border Grid.Column="2" Style="{StaticResource KanbanColumnStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="✅ Done"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                                <Border Background="#66BB6A"
                                       CornerRadius="12"
                                       Padding="8,4"
                                       Margin="10,0,0,0">
                                    <TextBlock x:Name="DoneCountText"
                                              Text="0"
                                              FontSize="12"
                                              FontWeight="Bold"
                                              Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Done Items -->
                            <ListBox x:Name="DoneListBox"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    AllowDrop="True"
                                    Drop="DoneColumn_Drop"
                                    DragEnter="Column_DragEnter"
                                    DragLeave="Column_DragLeave">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TodoCardStyle}"
                                               MouseLeftButtonDown="TodoCard_MouseDown"
                                               MouseMove="TodoCard_MouseMove"
                                               MouseLeftButtonUp="TodoCard_MouseUp"
                                               Tag="{Binding}"
                                               Opacity="0.7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                          Text="{Binding Title}"
                                                          FontSize="15"
                                                          FontWeight="Bold"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          TextWrapping="Wrap"
                                                          TextDecorations="Strikethrough"
                                                          Margin="0,0,0,8"/>

                                                <TextBlock Grid.Row="1"
                                                          Text="{Binding Description}"
                                                          FontSize="12"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          TextWrapping="Wrap"
                                                          Margin="0,0,0,10"
                                                          MaxHeight="40"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Style="{StaticResource PriorityBadgeStyle}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding PriorityColor}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Priority}"
                                                                  FontSize="10"
                                                                  FontWeight="Bold"
                                                                  Foreground="White"/>
                                                    </Border>

                                                    <Border Style="{StaticResource CategoryBadgeStyle}"
                                                           Visibility="{Binding Category, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Category}"
                                                                  FontSize="10"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <Grid Grid.Row="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                              Text="{Binding DueDateDisplay}"
                                                              FontSize="11"
                                                              Foreground="{DynamicResource TextTertiaryBrush}"
                                                              VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="✓"
                                                                  FontSize="11"
                                                                  Margin="0,0,4,0"
                                                                  Foreground="#66BB6A"
                                                                  FontWeight="Bold"/>
                                                        <TextBlock Text="Completed"
                                                                  FontSize="11"
                                                                  Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Sticky Notes Canvas -->
            <ScrollViewer x:Name="StickyNotesScrollViewer"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Visibility="Collapsed">
                <Canvas x:Name="StickyNotesCanvas"
                       Width="2000"
                       Height="2000"
                       Background="Transparent"
                       AllowDrop="True"/>
            </ScrollViewer>

            <!-- Loading Indicator -->
            <Grid x:Name="LoadingPanel" Visibility="Collapsed">
                <Grid.Background>
                    <SolidColorBrush Color="{DynamicResource PrimaryBackgroundColor}" Opacity="0.8"/>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Loading..."
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
