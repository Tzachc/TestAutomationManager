<UserControl x:Class="TestAutomationManager.Controls.ColumnFilterPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="250">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="2"
                              Direction="270"
                              Color="Black"
                              Opacity="0.25"/>
        </Border.Effect>
        <Border.Resources>

            <!-- Button Style -->
            <Style x:Key="FilterButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TextBox Style -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <StackPanel>
            <!-- Column Name Header -->
            <TextBlock x:Name="ColumnNameText"
                       Text="Filter Column"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Sort Section -->
            <TextBlock Text="SORT"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>

            <Button x:Name="SortAscendingButton"
                    Style="{StaticResource FilterButton}"
                    Click="SortAscending_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↑" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Sort Smallest to Highest" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button x:Name="SortDescendingButton"
                    Style="{StaticResource FilterButton}"
                    Click="SortDescending_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↓" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Sort Highest to Smallest" FontSize="12"/>
                </StackPanel>
            </Button>

            <!-- Separator -->
            <Border Height="1"
                    Background="{DynamicResource BorderBrush}"
                    Margin="0,6,0,10"/>

            <!-- Text Filter Section -->
            <TextBlock Text="TEXT FILTER"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="FilterTypeComboBox"
                      SelectedIndex="0"
                      Margin="0,0,0,6"
                      SelectionChanged="FilterTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="Equal"/>
                <ComboBoxItem Content="Begin With"/>
                <ComboBoxItem Content="Contains"/>
            </ComboBox>

            <TextBox x:Name="FilterValueTextBox"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,10"
                     IsEnabled="True"
                     KeyDown="FilterValueTextBox_KeyDown"/>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="ApplyButton"
                        Content="Apply"
                        Style="{StaticResource FilterButton}"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,4,0"
                        IsEnabled="True"
                        Click="Apply_Click"/>

                <Button Grid.Column="1"
                        x:Name="ClearButton"
                        Content="Clear"
                        Style="{StaticResource FilterButton}"
                        Background="#FF5252"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        Margin="4,0,0,0"
                        Click="Clear_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
